# ─── Backend ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render sets this automatically when DB is linked)
# Local dev: leave empty to use SQLite fallback
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DBNAME

# Admin token for write operations on /api/assignments
# Generate a strong random token: python -c "import secrets; print(secrets.token_hex(32))"
COA_ADMIN_TOKEN=your-secret-admin-token-here

# Deployed frontend URL — used for CORS (no trailing slash)
FRONTEND_ORIGIN=https://your-portfolio.onrender.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL of the deployed backend (no trailing slash)
VITE_API_URL=https://your-api.onrender.com
